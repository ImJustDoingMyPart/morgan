# Paquete de Arch de morgan, desde git. Sin paquete: install.sh, en la raíz del repo.
#
#   makepkg -si
#
# Lo que el paquete no puede hacer por cada usuario lo dice morgan.install al instalar:
# la línea de morgan en ~/.config/hypr/hyprland.lua y habilitar la unidad.

pkgname=morgan-git
_nombre=morgan
pkgver=r0
pkgrel=1
pkgdesc='Shell de escritorio para Hyprland: barra, centro de control, notificaciones, launcher, OSD y bloqueo'
arch=('x86_64' 'aarch64')
url='https://github.com/ImJustDoingMyPart/morgan'
# El código, GPL; el tema y las plantillas de /usr/share/morgan, MIT (con sus créditos).
license=('GPL-3.0-or-later' 'MIT')
depends=(
    'hyprland>=0.56'
    'gtk4>=1:4.22'
    'gtk4-layer-shell'
    'libpulse'
    'glib2'
    'pam'
    'systemd'
    'curl'
    'wl-clipboard'
)
makedepends=('cargo' 'git')
optdepends=(
    'matugen: temas (también los curados: las plantillas pasan por matugen)'
    'awww: fondos de pantalla'
    'libvips: miniaturas de la banda de fondos'
    'hyprsunset: luz nocturna'
    'ddcutil: brillo de monitores externos (DDC/CI)'
    'hyprshot: capturas de pantalla'
    'cliphist: launcher, portapapeles'
    'wtype: launcher, escribir símbolos'
    'libqalculate: calculadora'
    'rofimoji: launcher, datos de los símbolos'
    'libcanberra: sonidos del sistema'
    'uwsm: lanzar apps como unidades de systemd'
    'gpu-screen-recorder-ui: indicador y control de grabación'
    'papirus-folders: color de las carpetas del tema de íconos'
    'jq: morgan-cuota (cuotas de Claude Code y Antigravity)'
)
provides=('morgan' 'notification-daemon')
conflicts=('morgan')
backup=('etc/pam.d/morgan-lock')
install=morgan.install
source=("$_nombre::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_nombre"
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd "$_nombre"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_nombre"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p morgan -p morganctl -p morgan-lock
}

package() {
    cd "$_nombre"
    install -Dm755 target/release/{morgan,morganctl,morgan-lock} -t "$pkgdir/usr/bin/"
    install -Dm755 dist/morgan-captura dist/morgan-cuota -t "$pkgdir/usr/bin/"

    install -dm755 "$pkgdir/usr/lib/systemd/user"
    local u
    for u in morgan.service morgan-lock.service; do
        sed 's|%h/.local/bin|/usr/bin|g' "dist/$u" >"$pkgdir/usr/lib/systemd/user/$u"
    done
    # Con nombre propio: los otros servidores de notificaciones traen el suyo con el mismo
    # Name, y así los archivos no chocan.
    install -Dm644 dist/org.freedesktop.Notifications.service \
        "$pkgdir/usr/share/dbus-1/services/org.morgan.Notifications.service"
    install -Dm644 dist/pam.d/morgan-lock "$pkgdir/etc/pam.d/morgan-lock"
    # El tema propio y sus plantillas: el motor de temas los busca en /usr/share/morgan.
    install -dm755 "$pkgdir/usr/share/morgan"
    cp -r --no-preserve=ownership dist/share/morgan/. "$pkgdir/usr/share/morgan/"
    find "$pkgdir/usr/share/morgan" -type f -exec chmod 644 {} +
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 dist/share/morgan/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-temas"
}
